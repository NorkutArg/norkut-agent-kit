{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/secret-guard.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/tenant-guard.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/contract-guard.js" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/branch-guard.js" }
        ]
      }
    ]
  }
}
