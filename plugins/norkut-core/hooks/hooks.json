{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/secret-guard.mjs" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/tenant-guard.mjs" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/contract-guard.mjs" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/branch-guard.mjs" }
        ]
      }
    ]
  }
}
